---
import { SITE } from '~/data/site';

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '/#features' },
      { label: 'Security', href: '/#security' },
      { label: 'Download', href: '/download' },
      { label: 'Changelog', href: '/changelog' },
    ],
  },
  {
    title: 'Platforms',
    links: [
      { label: 'SSH client for macOS', href: '/ssh-client-mac' },
      { label: 'SSH client for Windows', href: '/ssh-client-windows' },
      { label: 'SSH client for Linux', href: '/ssh-client-linux' },
      { label: 'Termius alternative', href: '/termius-alternative' },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'GitHub', href: SITE.githubUrl, external: true },
      { label: 'Issues', href: `${SITE.githubUrl}/issues`, external: true },
      { label: 'Roadmap', href: `${SITE.githubUrl}/blob/main/ROADMAP.md`, external: true },
      { label: 'Releases', href: SITE.releasesUrl, external: true },
    ],
  },
  {
    title: 'About',
    links: [
      { label: 'Privacy', href: '/privacy' },
      { label: 'License (MIT)', href: `${SITE.githubUrl}/blob/main/LICENSE`, external: true },
      { label: 'Donate', href: SITE.donateUrl, external: true },
    ],
  },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" class="site-footer__name">
        <img src="/brand/logo.png" alt="" width="24" height="24" />
        {SITE.name}
      </a>
      <p>Free SSH and SFTP client for macOS, Windows, and Linux.</p>
    </div>

    <div class="site-footer__cols">
      {columns.map((col) => (
        <div>
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...('external' in link && link.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="site-footer__bottom">
    <span>© {new Date().getFullYear()} {SITE.author}</span>
    <span>v{SITE.version}</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 112px;
    padding: 48px 20px 32px;
    border-top: 1px solid var(--border);
  }

  .site-footer__inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    gap: 40px;
  }

  @media (min-width: 860px) {
    .site-footer__inner {
      grid-template-columns: 260px 1fr;
      gap: 64px;
    }
  }

  .site-footer__name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .site-footer__name img {
    border-radius: 6px;
  }

  .site-footer__brand p {
    max-width: 240px;
    margin: 12px 0 0;
    color: var(--fg-subtle);
    font-size: 14px;
    line-height: 1.5;
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px 24px;
  }

  @media (min-width: 640px) {
    .site-footer__cols {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  h2 {
    margin: 0 0 12px;
    color: var(--fg);
    font-size: 13px;
    font-weight: 500;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: 8px;
  }

  .site-footer__cols a {
    color: var(--fg-muted);
    font-size: 14px;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-footer__cols a:hover {
    color: var(--fg);
  }

  .site-footer__bottom {
    max-width: 1120px;
    margin: 48px auto 0;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--fg-subtle);
    font-size: 13px;
  }
</style>
