---
interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<figure class="shot">
  <img src={src} alt={alt} width="1800" height="1200" loading="lazy" decoding="async" />
</figure>

<style>
  .shot {
    margin: 24px 0 0;
    padding: 6px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface-1);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
</style>
