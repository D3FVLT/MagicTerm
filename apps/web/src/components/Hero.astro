---
import { SITE } from '~/data/site';

const frames = [
  {
    id: 'servers',
    label: 'Servers',
    src: '/screenshots/servers.webp',
    alt: 'Server list in Magic Term',
  },
  {
    id: 'terminal',
    label: 'Terminal',
    src: '/screenshots/terminal.webp',
    alt: 'Terminal session in Magic Term',
  },
  {
    id: 'files',
    label: 'Files',
    src: '/screenshots/sftp.webp',
    alt: 'SFTP file manager in Magic Term',
  },
  {
    id: 'snippets',
    label: 'Snippets',
    src: '/screenshots/snippets.webp',
    alt: 'Snippet list in Magic Term',
  },
];
---

<section class="hero">
  <div class="hero__copy">
    <h1>SSH, files, and secrets in one window.</h1>
    <p>Free SSH and SFTP client for macOS, Windows, and Linux. Encryption stays on this device.</p>
    <div class="hero__actions">
      <a href="/download" class="hero__download">Download</a>
      <a href={SITE.githubUrl} target="_blank" rel="noopener">GitHub</a>
    </div>
  </div>

  <div class="hero__stage" data-hero>
    <div class="hero__tabs" role="tablist" aria-label="Screens">
      {frames.map((frame, index) => (
        <button
          type="button"
          role="tab"
          id={`hero-tab-${frame.id}`}
          data-tab
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`hero-panel-${frame.id}`}
          tabindex={index === 0 ? 0 : -1}
        >
          {frame.label}
        </button>
      ))}
    </div>
    <div class="hero__frames">
      {frames.map((frame, index) => (
        <div
          class:list={['hero__panel', { 'is-active': index === 0 }]}
          id={`hero-panel-${frame.id}`}
          role="tabpanel"
          data-panel
          aria-labelledby={`hero-tab-${frame.id}`}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <img
            src={frame.src}
            alt={frame.alt}
            width="1800"
            height="1200"
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-hero]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer = 0;

    const show = (next: number) => {
      index = next;
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        panel.classList.toggle('is-active', i === index);
        panel.setAttribute('aria-hidden', i === index ? 'false' : 'true');
      });
    };

    const arm = () => {
      window.clearInterval(timer);
      if (reduced) return;
      timer = window.setInterval(() => show((index + 1) % panels.length), 9000);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        show(i);
        arm();
      });
    });

    root.addEventListener('keydown', (event) => {
      if (!(event instanceof KeyboardEvent)) return;
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      const delta = event.key === 'ArrowRight' ? 1 : -1;
      const next = (index + delta + tabs.length) % tabs.length;
      show(next);
      tabs[next]?.focus();
      arm();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) window.clearInterval(timer);
      else arm();
    });

    arm();
  }
</script>

<style>
  .hero {
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px 24px 0;
  }

  .hero__copy h1 {
    margin: 0;
    max-width: 16ch;
    color: var(--fg);
    font-size: clamp(36px, 5vw, 52px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .hero__copy p {
    max-width: 38rem;
    margin: 12px 0 0;
    color: var(--fg-muted);
    font-size: 16px;
    line-height: 1.5;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    margin-top: 20px;
  }

  .hero__download {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 16px;
    background: var(--accent);
    color: var(--accent-fg);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .hero__download:hover {
    background: var(--accent-hover);
  }

  .hero__actions a:not(.hero__download) {
    color: var(--accent);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .hero__actions a:not(.hero__download):hover {
    color: var(--accent-hover);
  }

  .hero__stage {
    margin-top: 28px;
  }

  .hero__tabs {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--border);
  }

  .hero__tabs button {
    margin: 0;
    padding: 8px 12px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--fg-muted);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  .hero__tabs button[aria-selected='true'] {
    color: var(--fg);
    border-bottom-color: var(--fg);
  }

  .hero__frames {
    position: relative;
    aspect-ratio: 3 / 2;
    border: 1px solid var(--border);
    border-top: 0;
    background: var(--surface-1);
  }

  .hero__panel {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 480ms linear;
  }

  .hero__panel.is-active {
    opacity: 1;
  }

  .hero__panel img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__panel {
      transition: none;
    }
  }
</style>
