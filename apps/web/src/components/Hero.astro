---
import { SITE } from '~/data/site';
---

<section class="hero">
  <div class="hero__copy">
    <a href="/changelog" class="hero__release">
      <span class="hero__dot" aria-hidden="true"></span>
      What's new in {SITE.version}
    </a>

    <h1>A free SSH and SFTP client with an encrypted vault</h1>

    <p class="hero__lead">
      Magic Term keeps your servers, passwords, keys, and snippets encrypted on your computer. Open a
      terminal or browse files on any of them. Use it without an account, or sign in to
      sync the vault between machines.
    </p>

    <div class="hero__actions">
      <a href="/download" class="btn btn--primary" data-os-download>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 4v12m0 0 5-5m-5 5-5-5M5 20h14" />
        </svg>
        <span data-os-label>Download</span>
      </a>
      <a href={SITE.githubUrl} class="btn btn--ghost" target="_blank" rel="noopener">Source on GitHub</a>
    </div>

    <p class="hero__meta">
      macOS, Windows, and Linux. MIT license. Builds are not code-signed; each installer has a SHA256
      checksum on the <a href="/download#sha256" class="link">download page</a>.
    </p>
  </div>

  <figure class="hero__shot">
    <picture>
      <source media="(max-width: 640px)" srcset="/screenshots/sftp-narrow.webp" width="1000" height="840" />
      <img
        src="/screenshots/sftp.webp"
        alt="Magic Term with a local folder on the left and the server's /root folder on the right"
        width="1800"
        height="1200"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </figure>
</section>

<script>
  // Name the visitor's OS on the button. The link still goes to /download,
  // where the installer list and checksums are.
  const label = document.querySelector('[data-os-label]');
  const link = document.querySelector<HTMLAnchorElement>('[data-os-download]');
  const platform =
    (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ||
    navigator.userAgent;
  const os = /mac/i.test(platform) && !/iphone|ipad/i.test(navigator.userAgent)
    ? { name: 'macOS', id: 'macos' }
    : /win/i.test(platform)
      ? { name: 'Windows', id: 'windows' }
      : /linux/i.test(platform) && !/android/i.test(navigator.userAgent)
        ? { name: 'Linux', id: 'linux' }
        : null;
  if (os && label && link) {
    label.textContent = `Download for ${os.name}`;
    link.href = `/download#${os.id}`;
  }
</script>

<style>
  .hero {
    max-width: 1120px;
    margin: 0 auto;
    padding: 72px 20px 0;
  }

  .hero__copy {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .hero__release {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-muted);
    font-size: 13px;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .hero__release:hover {
    border-color: var(--border-strong);
    color: var(--fg);
  }

  .hero__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--success);
  }

  h1 {
    margin: 20px 0 0;
    color: var(--fg);
    font-size: clamp(34px, 6vw, 58px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.06;
    text-wrap: balance;
  }

  .hero__lead {
    max-width: 600px;
    margin: 20px auto 0;
    color: var(--fg-muted);
    font-size: 18px;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .hero__meta {
    max-width: 520px;
    margin: 20px auto 0;
    color: var(--fg-subtle);
    font-size: 13px;
    line-height: 1.55;
  }

  .hero__meta .link {
    color: var(--fg-muted);
  }

  .hero__shot {
    margin: 56px 0 0;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface-1);
  }

  .hero__shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 48px;
    }

    .hero__copy {
      text-align: left;
    }

    .hero__lead {
      font-size: 17px;
      margin-left: 0;
    }

    .hero__actions {
      justify-content: flex-start;
    }

    .hero__actions .btn {
      flex: 1 1 100%;
    }

    .hero__meta {
      margin-left: 0;
    }

    .hero__shot {
      margin-top: 40px;
      padding: 4px;
      border-radius: 10px;
    }

    .hero__shot img {
      border-radius: 7px;
    }
  }
</style>
