---
import { SITE } from '~/data/site';
---

<section class="end">
  <a href="/download">Download</a>
  <p>v{SITE.version} for macOS, Windows, and Linux.</p>
</section>

<style>
  .end {
    max-width: 1080px;
    margin: 0 auto;
    padding: 28px 24px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    align-items: center;
  }

  a {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 16px;
    background: var(--accent);
    color: var(--accent-fg);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  a:hover {
    background: var(--accent-hover);
  }

  p {
    margin: 0;
    color: var(--fg-muted);
    font-size: 14px;
  }
</style>
