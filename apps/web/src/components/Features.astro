---
import Shot from './Shot.astro';

const rows = [
  {
    title: 'Terminal',
    text: 'Split panes, search in the scrollback, 256 colors.',
    src: '/screenshots/terminal.webp',
    alt: 'Terminal session in Magic Term',
  },
  {
    title: 'SFTP',
    text: 'Upload and download on the same SSH connection.',
    src: '/screenshots/sftp.webp',
    alt: 'SFTP file manager in Magic Term',
  },
  {
    title: 'Snippets',
    text: 'Encrypted commands. {{name}} asks for a value before it pastes.',
    src: '/screenshots/snippets.webp',
    alt: 'Snippet list in Magic Term',
  },
];
---

<section id="features" class="features">
  {rows.map((row) => (
    <article>
      <h2>{row.title}</h2>
      <p>{row.text}</p>
      <Shot src={row.src} alt={row.alt} />
    </article>
  ))}
</section>

<style>
  .features {
    max-width: 1080px;
    margin: 0 auto;
    padding: 64px 24px 0;
  }

  article + article {
    margin-top: 48px;
  }

  h2 {
    margin: 0;
    color: var(--fg);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  p {
    margin: 8px 0 0;
    color: var(--fg-muted);
    font-size: 16px;
    line-height: 1.5;
  }
</style>
