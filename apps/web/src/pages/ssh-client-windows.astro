---
import Base from '~/layouts/Base.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import Shot from '~/components/Shot.astro';
import { SITE } from '~/data/site';
import '~/styles/landing.css';

const title = 'SSH client for Windows';
const description =
  'Magic Term is a free SSH and SFTP client for Windows 10 and 11. The build is not signed. SHA256 is on the download page.';

const VERSION = SITE.version;
const RELEASE_BASE = `https://github.com/${SITE.githubRepo}/releases/download/v${VERSION}`;
---

<Base title={title} description={description}>
  <Header />
  <main class="landing">
    <header class="landing__header">
      <h1>SSH client for Windows</h1>
      <p class="landing__lead">
        Free SSH and SFTP client for Windows 10 and 11, x64. Encryption stays on this device. Local mode needs no account.
      </p>
      <div class="landing__cta">
        <a href={`${RELEASE_BASE}/MagicTerm-${VERSION}-x64.exe`} class="landing__button landing__button--primary">
          Installer (.exe)
        </a>
        <a href="/download" class="landing__button landing__button--secondary">All downloads</a>
      </div>
    </header>

    <Shot src="/screenshots/terminal.webp" alt="Terminal session in Magic Term" />

    <section class="landing__section">
      <h2>Install</h2>
      <ol class="landing__list">
        <li>Run MagicTerm-{VERSION}-x64.exe.</li>
        <li>The build is not signed. SmartScreen may say the publisher is unrecognized.</li>
        <li>After you accept an update, the installer downloads and runs on restart.</li>
        <li>SHA256 is on the <a href="/download">download page</a>.</li>
      </ol>
    </section>

    <section class="landing__section">
      <h2>On this PC</h2>
      <ul class="landing__list">
        <li>Import reads host, port, and user from the OpenSSH config, if you have one.</li>
        <li>SFTP is on the same SSH connection.</li>
        <li>Sync is optional. Without an account the vault stays in a local file.</li>
      </ul>
    </section>
  </main>
  <Footer />
</Base>
