---
import Base from '~/layouts/Base.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import Shot from '~/components/Shot.astro';
import { SITE } from '~/data/site';
import '~/styles/landing.css';

const title = 'SSH client for macOS';
const description =
  'Magic Term is a free SSH and SFTP client for Apple Silicon and Intel Macs. Encryption stays on the device. The build is not signed. SHA256 is on the download page.';

const VERSION = SITE.version;
const RELEASE_BASE = `https://github.com/${SITE.githubRepo}/releases/download/v${VERSION}`;
---

<Base title={title} description={description}>
  <Header />
  <main class="landing">
    <header class="landing__header">
      <h1>SSH client for macOS</h1>
      <p class="landing__lead">
        Free SSH and SFTP client for Apple Silicon and Intel. Encryption stays on this device. Local mode needs no account.
      </p>
      <div class="landing__cta">
        <a href={`${RELEASE_BASE}/MagicTerm-${VERSION}-arm64.dmg`} class="landing__button landing__button--primary">
          Apple Silicon (.dmg)
        </a>
        <a href={`${RELEASE_BASE}/MagicTerm-${VERSION}-x64.dmg`} class="landing__button landing__button--secondary">
          Intel (.dmg)
        </a>
      </div>
    </header>

    <Shot src="/screenshots/servers.webp" alt="Server list in Magic Term" />

    <section class="landing__section">
      <h2>Install</h2>
      <ol class="landing__list">
        <li>Open the .dmg and drag Magic Term into Applications.</li>
        <li>
          The build is not signed or notarized. On first launch, clear the quarantine flag:
          <pre class="landing__code"><code>xattr -cr "/Applications/Magic Term.app"</code></pre>
        </li>
        <li>An update check opens the GitHub release page. It does not install the app for you.</li>
        <li>SHA256 for both files is on the <a href="/download">download page</a>.</li>
      </ol>
    </section>

    <section class="landing__section">
      <h2>On this Mac</h2>
      <ul class="landing__list">
        <li>Import reads host, port, and user from ~/.ssh/config. It does not upload the identity-file path.</li>
        <li>SFTP is on the same SSH connection.</li>
        <li>Sync is optional. Without an account the vault stays in a local file.</li>
      </ul>
    </section>
  </main>
  <Footer />
</Base>
