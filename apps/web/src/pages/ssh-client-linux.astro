---
import Base from '~/layouts/Base.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import Shot from '~/components/Shot.astro';
import { SITE } from '~/data/site';
import '~/styles/landing.css';

const title = 'SSH client for Linux';
const description =
  'Magic Term is a free SSH and SFTP client for Linux. AppImage, .deb, and an AUR package. Updates are manual. SHA256 is on the download page.';

const VERSION = SITE.version;
const RELEASE_BASE = `https://github.com/${SITE.githubRepo}/releases/download/v${VERSION}`;
const deb = `MagicTerm-${VERSION}-amd64.deb`;
---

<Base title={title} description={description}>
  <Header />
  <main class="landing">
    <header class="landing__header">
      <h1>SSH client for Linux</h1>
      <p class="landing__lead">
        Free SSH and SFTP client. AppImage, a Debian package, and an AUR package. Encryption stays on this device. Local mode needs no account.
      </p>
      <div class="landing__cta">
        <a href={`${RELEASE_BASE}/MagicTerm-${VERSION}-x86_64.AppImage`} class="landing__button landing__button--primary">
          AppImage (x64)
        </a>
        <a href={`${RELEASE_BASE}/${deb}`} class="landing__button landing__button--secondary">.deb</a>
        <a href="https://aur.archlinux.org/packages/magicterm-bin" class="landing__button landing__button--secondary" target="_blank" rel="noopener">
          AUR
        </a>
      </div>
    </header>

    <Shot src="/screenshots/terminal.webp" alt="Terminal session in Magic Term" />

    <section class="landing__section">
      <h2>Install</h2>
      <h3>Arch</h3>
      <pre class="landing__code"><code>yay -S magicterm-bin</code></pre>
      <h3>Debian and Ubuntu</h3>
      <p>
        <a href={`${RELEASE_BASE}/${deb}`}>{deb}</a>
      </p>
      <pre class="landing__code"><code>sudo dpkg -i {deb}</code></pre>
      <h3>AppImage</h3>
      <pre class="landing__code"><code>chmod +x MagicTerm-{VERSION}-x86_64.AppImage
./MagicTerm-{VERSION}-x86_64.AppImage</code></pre>
      <p>Updates are manual. SHA256 is on the <a href="/download">download page</a>.</p>
    </section>

    <section class="landing__section">
      <h2>On this machine</h2>
      <ul class="landing__list">
        <li>Import reads host, port, and user from ~/.ssh/config. It does not upload the identity-file path.</li>
        <li>SFTP is on the same SSH connection.</li>
        <li>Sync is optional. Without an account the vault stays in a local file.</li>
      </ul>
    </section>
  </main>
  <Footer />
</Base>
