---
import Base from '~/layouts/Base.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { SITE } from '~/data/site';
import { CHANGELOG, parseInline } from '@magicterm/shared';

const isExternal = (href: string) => /^https?:\/\//.test(href) && !href.includes(SITE.domain);
---

<Base
  title="Changelog"
  description="Release notes and version history for Magic Term."
>
  <Header />
  <main class="changelog-page">
    <header class="changelog-page__header">
      <h1>Changelog</h1>
      <p>
        What changed in every release, newest first. Installers and checksums for each version
        live on <a href={SITE.releasesUrl} target="_blank" rel="noopener">GitHub Releases</a>.
      </p>
    </header>

    {CHANGELOG.map((release, index) => (
      <section class="release">
        <header class="release__head">
          <h2>v{release.version}</h2>
          <span class="release__date">{release.date}</span>
          {index === 0 && <span class="release__tag">Latest</span>}
          {release.badge === 'security' && (
            <span class="release__tag release__tag--security">Security</span>
          )}
        </header>
        <ul>
          {release.items.map((item) => (
            <li>
              <strong>{item.label}:</strong>{' '}
              {parseInline(item.text).map((token) =>
                token.kind === 'code' ? (
                  <code>{token.value}</code>
                ) : token.kind === 'link' ? (
                  // Kept on one line: Astro preserves JSX whitespace, so a
                  // wrapped child would render as " #19 " inside the link.
                  <a href={token.href} {...(isExternal(token.href) ? { target: '_blank', rel: 'noopener' } : {})}>{token.value}</a>
                ) : (
                  token.value
                )
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}

    <footer class="changelog-page__footer">
      <a href={SITE.releasesUrl} target="_blank" rel="noopener" class="btn-cta btn-cta--ghost">
        See full release history on GitHub →
      </a>
    </footer>
  </main>
  <Footer />
</Base>

<style>
  .changelog-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 40px 24px 0;
  }

  .changelog-page__header {
    margin-bottom: 32px;
  }

  .changelog-page__header h1 {
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--fg);
    margin: 0 0 16px;
  }

  .changelog-page__header p {
    color: var(--fg-muted);
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
  }

  .changelog-page__header a {
    color: var(--accent);
    text-decoration: none;
  }

  .release {
    border-left: 2px solid var(--border);
    padding: 0 0 40px 24px;
    position: relative;
  }

  .release::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 8px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .release__head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .release__head h2 {
    font-size: 24px;
    font-weight: 700;
    color: var(--fg);
    margin: 0;
  }

  .release__date {
    color: var(--fg-subtle);
    font-size: 14px;
  }

  .release__tag {
    color: var(--fg-subtle);
    font-size: 13px;
  }

  .release__tag--security {
    color: var(--warning);
  }

  .release ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .release li {
    color: var(--fg-muted);
    font-size: 15px;
    line-height: 1.55;
    padding-left: 16px;
    position: relative;
  }

  .release li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--fg-subtle);
  }

  .release strong {
    color: var(--fg);
    font-weight: 600;
  }

  .release code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.88em;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 1px 5px;
    color: var(--fg);
  }

  .release a {
    color: var(--accent);
    text-decoration: none;
  }

  .release a:hover {
    text-decoration: underline;
  }

  .changelog-page__footer {
    text-align: center;
    margin-top: 80px;
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 50px;
    padding: 0 24px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-cta--ghost {
    background: var(--surface-2);
    color: var(--fg);
    border: 1px solid var(--border);
  }

  .btn-cta--ghost:hover {
    background: var(--surface-3);
  }
</style>
