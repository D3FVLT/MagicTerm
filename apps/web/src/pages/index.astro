---
import Base from '~/layouts/Base.astro';
import Header from '~/components/Header.astro';
import Hero from '~/components/Hero.astro';
import Features from '~/components/Features.astro';
import SecuritySection from '~/components/SecuritySection.astro';
import DownloadCTA from '~/components/DownloadCTA.astro';
import Footer from '~/components/Footer.astro';

const title = 'SSH and SFTP client for macOS, Windows, and Linux';
const description =
  'Magic Term is a free SSH and SFTP client. Secrets are encrypted on the device. Local mode needs no account. Builds are unsigned; SHA256 is on the download page.';
---

<Base title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <Features />
    <SecuritySection />
    <DownloadCTA />
  </main>
  <Footer />
</Base>
