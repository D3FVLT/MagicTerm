---
import Base from '~/layouts/Base.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { SITE } from '~/data/site';
import '~/styles/landing.css';

const title = 'Termius alternative';
const description =
  'Magic Term is a free SSH and SFTP client. Local mode needs no account. Sync is optional. Secrets are encrypted on the device. Builds are not signed.';

const comparison = [
  { feature: 'Price', magicterm: 'Free. MIT license.', termius: 'Proprietary. Sync is a paid plan.' },
  { feature: 'Account', magicterm: 'Optional. The vault can stay in a local file.', termius: 'An account is how sync works.' },
  { feature: 'Secrets', magicterm: 'AES-256-GCM on this device. The master password is not uploaded.', termius: 'See Termius for their model.' },
  { feature: 'SFTP', magicterm: 'On the same SSH connection.', termius: 'Yes.' },
  { feature: 'Snippets', magicterm: 'Encrypted. {{name}} asks before paste.', termius: 'Yes.' },
  { feature: 'Mobile', magicterm: 'No mobile app.', termius: 'iOS and Android.' },
];
---

<Base title={title} description={description}>
  <Header />
  <main class="landing">
    <header class="landing__header">
      <h1>A free SSH and SFTP client</h1>
      <p class="landing__lead">
        Local mode needs no account. Sync is a separate step, after you create one. The master password is not uploaded.
      </p>
      <div class="landing__cta">
        <a href="/download" class="landing__button landing__button--primary">Download</a>
        <a href={SITE.githubUrl} class="landing__button landing__button--secondary" target="_blank" rel="noopener">GitHub</a>
      </div>
    </header>

    <section class="landing__section">
      <h2>Magic Term and Termius</h2>
      <div class="landing__table-wrap">
        <table class="landing__table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Magic Term</th>
              <th>Termius</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <th scope="row">{row.feature}</th>
                <td>{row.magicterm}</td>
                <td>{row.termius}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="landing__section">
      <h2>Not in the app yet</h2>
      <ul class="landing__list">
        <li>No mobile app.</li>
        <li>No port-forwarding screen.</li>
        <li>Passphrase-protected SSH keys are not prompted for yet.</li>
        <li>Builds are not signed. SHA256 for each installer is on the <a href="/download">download page</a>.</li>
        <li>Team vault sharing is not a finished feature.</li>
      </ul>
    </section>
  </main>
  <Footer />
</Base>
