---
import { SITE } from '~/data/site';
import '~/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  /** Set true on /404 / /privacy etc. so search engines do not index them. */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = '/brand/og-image.png',
  canonical,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} - ${SITE.name}` : `${SITE.name} - ${SITE.tagline}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const ogImageUrl = new URL(image, SITE.url).toString();

const softwareApp = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  alternateName: ['MagicTerm', 'Magic Term SSH client'],
  description: SITE.description,
  url: SITE.url,
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'SSH client',
  operatingSystem: 'macOS, Windows, Linux',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  downloadUrl: SITE.latestReleaseUrl,
  softwareVersion: SITE.version,
  author: {
    '@type': 'Organization',
    name: SITE.author,
    url: SITE.githubUrl,
  },
  license: `https://github.com/${SITE.githubRepo}/blob/main/LICENSE`,
  featureList: [
    'SSH and SFTP client',
    'AES-256-GCM on device, key from PBKDF2-SHA-256',
    'Master password is not uploaded. Account stores a scrypt verifier',
    'Local mode with no account. Sync is optional',
    'Split terminal panes and scrollback search',
    'SFTP file manager',
    'Snippets with {{name}} prompts',
    'TOFU host-key check. Fingerprints stay on this machine',
    'Import host, port, and user from ~/.ssh/config',
    'macOS, Windows, Linux',
    'Builds are not signed. SHA256 is published',
    'No telemetry SDK',
  ],
};
---

<!doctype html>
<html lang="en" data-theme="onyx">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/brand/favicon.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}. ${SITE.tagline}`} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${SITE.name}. ${SITE.tagline}`} />

    <meta name="theme-color" content="#000000" />

    <script type="application/ld+json" set:html={JSON.stringify(softwareApp)} />

    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "5b62871b1f644566bb47b239a81538f7"}'
    ></script>
  </head>
  <body>
    <slot />
  </body>
</html>
